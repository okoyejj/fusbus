generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum MediaType {
  PROFILE
  LOGO
  GALLERY
}

enum EnquiryStatus {
  NEW
  REVIEWING
  CONTACTED
  AWAITING_RESPONSE
  INTRODUCTION_ARRANGED
  COMPLETED
  DECLINED
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(SELLER)
  emailVerified Boolean  @default(false)
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sellerProfile SellerProfile?
  assignedEnquiries InvestorEnquiry[] @relation("AssignedAdmin")
  adminNotes AdminNote[]
  auditLogs AuditLog[] @relation("AuditActor")
  notifications Notification[]
}

model SellerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  sellerReferenceId String? @unique
  fullName        String
  businessName    String
  phoneNumber     String?
  whatsappNumber  String?
  city            String?
  region          String?
  category        String?
  productsOrServices String?
  yearsInBusiness Int?
  employeeCount   Int?
  businessStage   String?
  socialLinks     Json?
  shortSummary    String?
  journeyStory    String?
  challenges      String?
  achievements    String?
  communityImpact String?
  futureGoals     String?
  supportNeeded   String?
  fundingAmount   Decimal? @db.Decimal(12, 2)
  useOfFunds      String?
  websiteUrl      String?
  consentReview   Boolean @default(false)
  consentPublish  Boolean @default(false)
  applicationStatus ApplicationStatus @default(DRAFT)
  isFeatured      Boolean @default(false)
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  sellerFacingMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  media SellerMedia[]
  investorEnquiries InvestorEnquiry[]

  @@index([applicationStatus])
  @@index([category])
  @@index([city])
  @@index([submittedAt])
}

model Investor {
  id               String   @id @default(cuid())
  fullName         String
  organisationName String?
  email            String
  phoneNumber      String?
  country          String?
  interestType     String?
  status           String   @default("ACTIVE")
  totalCommitted   Decimal? @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  enquiries InvestorEnquiry[]
  receipts InvestorTransactionReceipt[]

  @@unique([email, organisationName])
  @@index([email])
  @@index([status])
}

model SellerMedia {
  id              String    @id @default(cuid())
  sellerProfileId String
  mediaType       MediaType
  originalFileName String
  storedFileName  String
  fileUrl         String
  thumbnailUrl    String?
  mimeType        String
  fileSize        Int
  sortOrder       Int       @default(0)
  isPublic        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
}

model InvestorEnquiry {
  id              String @id @default(cuid())
  investorId      String?
  sellerProfileId String
  sellerReferenceId String
  fullName        String
  organisationName String?
  email           String
  phoneNumber     String?
  country         String
  interestType    String
  estimatedSupport String?
  message         String
  preferredContactMethod String
  consent         Boolean @default(false)
  status          EnquiryStatus @default(NEW)
  assignedAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  investor Investor? @relation(fields: [investorId], references: [id])
  assignedAdmin User? @relation("AssignedAdmin", fields: [assignedAdminId], references: [id])
  receipts InvestorTransactionReceipt[]
}

model InvestorTransactionReceipt {
  id              String   @id @default(cuid())
  investorId      String
  investorEnquiryId String?
  amount          Decimal? @db.Decimal(12, 2)
  currency        String   @default("GBP")
  transactionDate DateTime?
  originalFileName String
  storedFileName  String
  fileUrl         String
  mimeType        String
  fileSize        Int
  notes           String?
  status          String   @default("RECEIVED")
  uploadedByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorEnquiry InvestorEnquiry? @relation(fields: [investorEnquiryId], references: [id], onDelete: SetNull)

  @@index([investorId])
  @@index([investorEnquiryId])
  @@index([status])
}

model AdminNote {
  id                String @id @default(cuid())
  relatedEntityType String
  relatedEntityId   String
  adminUserId       String
  note              String
  createdAt         DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])
}

model Notification {
  id        String @id @default(cuid())
  userId    String?
  type      String
  subject   String
  message   String
  status    String @default("QUEUED")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
